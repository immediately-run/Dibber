{
  "name": "@immediately-run/dibber",
  "version": "0.4.0",
  "description": "Git as your issue tracker, in an open format built on Markdown: the Dibber format's validator and command-line tool, plus agent skills.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/dibber.git"
  },
  "bin": {
    "dibber": "bin/dibber.mjs"
  },
  "exports": {
    "./check": "./src/check.mjs",
    "./store": "./src/store.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "templates/",
    "ticket.schema.json",
    "config.schema.json",
    "SPEC.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "check": "node bin/dibber.mjs check",
    "check:release": "node scripts/check-release.mjs",
    "version": "node scripts/check-release.mjs --sync && git add .claude-plugin plugin.json",
    "site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "csv-parse": "^7.0.3",
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@immediately-run/sdk": ">=0.97.0"
  },
  "peerDependenciesMeta": {
    "@immediately-run/sdk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
